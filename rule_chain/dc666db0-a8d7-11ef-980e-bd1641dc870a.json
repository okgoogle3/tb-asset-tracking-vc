        "layoutX" : 201,
        "layoutY" : 660
      },
      "configuration" : {
        "scriptLang" : "TBEL",
        "jsScript" : "return {msg: msg, metadata: metadata, msgType: msgType};",
        "tbelScript" : "var result = {};\nvar variableMap = {\n    \"Temperature\" : \"Temperature\",\n    \"Battery level\" : \"BatteryLevel\",\n    \"Movement\" : \"movement\",\n    \"Idle\" : \"idle\",\n};\nvar thresholds = msg.alarmConfig.deviceThresholds;\n// return {msg: {test:thresholds}, metadata: metadata, msgType: \"POST_ATTRIBUTES_REQUEST\"};\n\n\nvar activeGlobal = msg.alarmConfig.isActive;\n\nif(thresholds!=null){\n    foreach(threshold : thresholds){\n    if(threshold.type == \"Temperature\" || threshold.type ==  \"Battery level\"){\n      type =  variableMap[threshold.type];\n    result.put(\"upperThreshold\" +type + \"Enabled\",threshold.status && activeGlobal);\n    result.put(\"lowerThreshold\" +type + \"Enabled\",threshold.status && activeGlobal);\n    result.put(\"equalThreshold\" +type + \"Enabled\",threshold.status && activeGlobal);\n    \n    result.put(\"upperThreshold\" + type,threshold.upperThreshold);\n    result.put(\"lowerThreshold\" + type,threshold.lowerThreshold);\n    result.put(\"equalThreshold\" + type,threshold.equalThreshold);\n    }else if (threshold.type == \"Movement\" || threshold.type == \"Idle\"){\n              type =  variableMap[threshold.type];\n        result.put(type + \"Enabled\",threshold.status && activeGlobal);\n        result.put(type + \"TimeSec\",threshold.durationThreshold);\n\n    }\n}\n}\n\n\nvar zoneThresolds = {};\nvar geofenceThresolds = {};\nvar areaAlarmRules = {};\n\nif( msg.alarmConfig.locationThresholds!=null){\n     foreach(locationThreshold : msg.alarmConfig.locationThresholds){\n         \nif (locationThreshold.eventType.contains(\"Geofence\")) {\n    processThresholds(locationThreshold.geofences, geofenceThresolds, locationThreshold.eventType, locationThreshold.duration);\n}\n\nif (locationThreshold.eventType.contains(\"Zone\")) {\n    processThresholds(locationThreshold.zones, zoneThresolds, locationThreshold.eventType, locationThreshold.duration);\n}\n     \n }\n}\n\n \n result.put(\"geofenceThresolds\",geofenceThresolds);\n result.put(\"zoneThresolds\",zoneThresolds);\n result.put(\"areaAlarmRules\",areaAlarmRules);\n\n\n\n\nreturn {msg: result, metadata: metadata, msgType: \"POST_ATTRIBUTES_REQUEST\"};\n\n\nfunction processThresholds(thresholdList, thresholdMap, eventType, durationKey) {\n    if (thresholdList != null) {\n        foreach (item : thresholdList) {\n            var itemId = item.id.id;\n            var insideEvent = eventType.contains(\"In\");\n            var type = insideEvent ? \"minInsideDuration\" : \"minOutsideDuration\";\n            areaAlarmRules.put(itemId,{\"name\":item.name,\"status\" : (insideEvent ? \"inside\" : \"outside\")});\n            var jsn = {};\n            if (thresholdMap[itemId] == null) {\n                jsn[type] = durationKey;\n                thresholdMap.put(itemId, jsn);\n            } else {\n                jsn = thresholdMap[itemId];\n                jsn[type] = durationKey;\n            }\n        }\n    }\n}"
      },
