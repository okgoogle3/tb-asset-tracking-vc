              "useMarkdownTextFunction" : true,
              "markdownTextPattern" : "",
              "markdownTextFunction" : "let controller = ctx.stateController;\nlet params = controller.getStateParams();\n\nconst assetsNumber = ctx.datasources.length;\n\nif (!params || !params.showAssets){\n    return `\n        <div class=\"widget-container\">\n            <tb-dashboard-state class=\"map-container\"\n                [ctx]=\"ctx\" [syncParentStateParams]=\"true\" stateId=\"monitoringNewMap\">\n            </tb-dashboard-state>\n            <div class=\"panel-container\">\n                <div class=\"panel-control\">\n                    <div class=\"total-assets-container\">\n                        <mat-icon class=\"icon build\">build</mat-icon>\n                        <span class=\"total-assets-label\">Total assets</span>\n                        <span class=\"total-assets-counter\">${assetsNumber}</span>\n                    </div>\n                    <button mat-button color=\"primary\" id=\"showAssets\">\n                        <mat-icon color=\"primary\" class=\"icon\">keyboard_arrow_up</mat-icon>\n                        <span>Show assets</span>\n                    </button>\n                </div>\n            </div>\n            \n        </div>\n    `;\n}\n\nreturn `\n        <div class=\"widget-container\">\n            <tb-dashboard-state class=\"map-container\"\n                [ctx]=\"ctx\" [syncParentStateParams]=\"true\" stateId=\"monitoringMap\">\n            </tb-dashboard-state>\n            <div class=\"panel-container extended\">\n                <div class=\"panel-control\">\n                    <div class=\"total-assets-container\">\n                        <mat-icon class=\"icon build\">build</mat-icon>\n                        <span class=\"total-assets-label\">Total assets</span>\n                        <span class=\"total-assets-counter\">${assetsNumber}</span>\n                    </div>\n                    <button mat-button color=\"primary\" id=\"hideAssets\">\n                        <mat-icon color=\"primary\" class=\"icon\">keyboard_arrow_down</mat-icon>\n                        <span>Hide assets</span>\n                    </button>\n                </div>\n                <div class=\"assets-table\">\n                    <tb-dashboard-state\n                        [ctx]=\"ctx\" [syncParentStateParams]=\"true\" stateId=\"monitoringAssetsList\">\n                    </tb-dashboard-state>\n                </div>\n            </div>\n        </div>\n    `;",
              "applyDefaultMarkdownStyle" : true,
              "markdownCss" : ".widget-container {\n    width: 100%;\n    height: 100%;\n    padding: 0;\n}\n\n.map-container {\n    width: 100%;\n    height: 100%;\n}\n\n.panel-container {\n    width: 100%;\n    position: absolute;\n    bottom: 0;\n    background-color: #FFFFFF;\n    border-top: 1px solid #D0D5DD;\n    z-index: 999;\n}\n\n.panel-container.extended {\n    height: 50%;\n}\n\n.panel-control {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 20px;\n}\n\n.extended .panel-control {\n    padding-bottom: 0;\n}\n\nbutton.mat-button {\n    display: flex;\n    flex-direction: row-reverse;\n    align-items: center;\n}\n\n.icon {\n    width: 20px;\n    height: 20px;\n    font-size: 20px;\n}\n\n.icon.build {\n    color: #344054;\n    margin-right: 8px;\n}\n\n.total-assets-container {\n    display: flex;\n    align-items: center;\n}\n\n.total-assets-label {\n    color: #344054;\n    line-height: 24px;\n    margin-right: 8px;\n}\n\n.total-assets-counter {\n    color: #0C111D;\n    font-weight: 600;\n    line-height: 24px;\n    letter-spacing: 0.16px;\n}\n\n.all-assets-container {\n    height: 70%!important;\n}\n\n.assets-table {\n    height: calc(100% - 56px);\n}"
