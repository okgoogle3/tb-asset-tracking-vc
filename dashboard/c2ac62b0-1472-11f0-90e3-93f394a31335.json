n      const [x, y] = point;\n      if (x < minX) { minX = x; }\n      if (x > maxX) { maxX = x; }\n      if (y < minY) { minY = y; }\n      if (y > maxY) { maxY = y; }\n    });\n    const polyWidth = maxX - minX;\n    const polyHeight = maxY - minY;\n    // Compute the scale factor so that the polygon fits inside the image.\n    // We use Math.min so that both dimensions fit inside the image.\n    const scaleFactor = Math.min(imgWidth / polyWidth, imgHeight / polyHeight);\n    console.log(\"!!! scaleFactor !!\", scaleFactor)\n    // Callback with the computed scale factor.\n    callback(scaleFactor);\n  };\n  // In case of error loading the image.\n  img.onerror = function() {\n    console.error(\"Error loading image.\");\n    callback(null);\n  };\n  // Set the image source to the base64 string (make sure the string includes the data URI prefix).\n  img.src = imageBase64;\n}\n",
