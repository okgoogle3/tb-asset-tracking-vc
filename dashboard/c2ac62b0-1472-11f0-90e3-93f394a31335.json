                    "color" : "rgba(143,143,143,0)"
                  },
                  "angle" : 45
                },
                "fillImage" : {
                  "type" : "function",
                  "imageFunction" : "let normalizedAngle = 0;\n\nif(data.perimeter && JSON.parse(data.perimeter)){\n    console.log(JSON.parse(data.perimeter));\n\n    const angle = getRectangleRotationAngle(JSON.parse(data.perimeter));\n    normalizedAngle = (angle + 360) % 360;\n    console.log(\"normalizedAngle\", 90-normalizedAngle)\n    \n}\n\nreturn {\n    url: data.image,\n    preserveAspectRatio: true,\n    opacity: 1,\n    angle: 90-normalizedAngle\n}\n\nfunction getRectangleRotationAngle(coords) {\n    // EPSG:3857 constants\n    const RADIUS = 6378137;\n\n    // Перетворення з lat/lon в метри за проекцією Web Mercator\n    function toWebMercator([lat, lon]) {\n        const x = RADIUS * lon * Math.PI / 180;\n        const y = RADIUS * Math.log(Math.tan(Math.PI / 4 + lat * Math.PI / 360));\n        return [x, y];\n    }\n\n    // Евклідова відстань\n    function distance(p1, p2) {\n        const dx = p2[0] - p1[0];\n        const dy = p2[1] - p1[1];\n        return Math.sqrt(dx * dx + dy * dy);\n    }\n\n    // Проєктуємо всі координати\n    const projected = coords.map(toWebMercator);\n\n    // Знаходимо найдовшу сторону\n    let maxDist = 0;\n    let edge = [0, 1];\n    for (let i = 0; i < projected.length; i++) {\n        const j = (i + 1) % projected.length;\n        const d = distance(projected[i], projected[j]);\n        if (d > maxDist) {\n            maxDist = d;\n            edge = [i, j];\n        }\n    }\n\n    const [p1, p2] = [projected[edge[0]], projected[edge[1]]];\n    const dx = p2[0] - p1[0];\n    const dy = p2[1] - p1[1];\n    const angleRad = Math.atan2(dy, dx);\n    const angleDeg = angleRad * 180 / Math.PI;\n\n    return angleDeg; // Повертає кут у градусах, може бути від -180 до +180\n}",
                  "images" : null
                },
