mainState\" *ngIf=\"ctx.stateController.getStateParams().stateId=='devices'\"\n                [ctx]=\"ctx\" [syncParentStateParams]=\"true\" stateId=\"devices\">\n            </tb-dashboard-state>\n        </div>\n    </div>        \n</div>",
              "markdownTextFunction" : "let controller = ctx.stateController;\nlet params = controller.getStateParams();\n\nparams.filtersFormGroupValue = null;\nparams.enabled = true;\ncontroller.updateState('default', params);\n\n\nreturn `\n    <div tb-toast toastTarget=\"layout\" class=\"layout\" fxLayout=\"column\">\n        <div *ngIf=\"ctx && ctx.stateController\" class=\"stateBlock\">\n                <tb-dashboard-state class=\"mainState\" *ngIf=\"ctx.stateController.getStateParams().stateId=='locations'\"\n                    [ctx]=\"ctx\" [syncParentStateParams]=\"true\" stateId=\"locations\">\n                </tb-dashboard-state>\n                <tb-dashboard-state class=\"mainState\" *ngIf=\"ctx.stateController.getStateParams().stateId=='locationDetails'\"\n                    [ctx]=\"ctx\" [syncParentStateParams]=\"true\" stateId=\"locationDetails\">\n                </tb-dashboard-state>\n                <tb-dashboard-state class=\"mainState\" *ngIf=\"ctx.stateController.getStateParams().stateId=='zoneDetails'\"\n                    [ctx]=\"ctx\" [syncParentStateParams]=\"true\" stateId=\"zoneDetails\">\n                </tb-dashboard-state>\n            </div>\n        </div>        \n    </div>\n`;",
              "applyDefaultMarkdownStyle" : true,
              "markdownCss" : ".layout{\n    width: 100%; \n    height: 100%; \n    padding: 0;\n}\n\n.layout .navigationLarge{\n    flex-basis: 15%;\n    min-width: 150px;\n    /*transition: flex-basis .6s ease-in-out;*/\n}\n\n.layout .navigationLarge.hide{\n    flex-basis: 0;\n    min-width: 0;\n}\n\n.layout .navigationSmall{\n    display: none;\n}\n\n.layout .stateBlock{\n    display: flex;\n    flex-direction: row;\n    height:100%; \n    width: 100%;\n}\n\n.layout .bodyWithSupport{\n    display: flex;\n    flex-direction: row;\n    height:100%; \n    width: 100%;\n    /*transition: flex-basis .4s ease-in-out;*/\n}\n\n.layout .bodyWithSupport.toggleShow{\n    flex-basis: 100%;\n}\n\n.layout .bodyWithSupport.toggleHide{\n    flex-basis: 100%;\n}\n\n@media screen and (max-width: 1399px) {\n    .layout .navigationLarge{\n        flex-basis: 15%;\n    }\n    \n    .layout .support{\n        flex-basis: 19%;\n    }\n\n    .layout .toggled{\n        /*flex-basis: 85%;*/\n    }\n\n}\n\n@media screen and (max-width: 1100px) {\n    \n    .layout .navigationLarge{\n        display: none;   \n    }\n    \n    .layout .navigationSmall{\n        display: block;\n        width: 180px;\n        z-index: 10;\n        transition: width .4s ease-in-out;\n    }\n    \n    .layout .navigationSmall.hide{\n        width: 0;\n    }\n    \n    .layout .bodyWithSupport.toggleShow,\n    .layout .bodyWithSupport.toggleHide{\n        flex-basis: calc(100% - 180px);\n        left: 180px;\n    }\n}\n\n@media screen and (max-width: 600px) {\n    \n    /*.layout .navigation{*/\n    /*    flex-basis: 7%;*/\n    /*}*/\n    \n    /*.layout .stateBlock{*/\n    /*    flex-direction: column;*/\n    /*}*/\n}\n\n"
